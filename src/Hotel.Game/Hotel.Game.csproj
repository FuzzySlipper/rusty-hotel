<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductEntryType>Hotel.Game.HotelProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-hotel</RustyEngineProductId>
    <RustyEngineProductTitle>Hotel Endless</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$(MSBuildProjectDirectory)/../ui</RustyEngineProductUiRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductContentRoot>$(MSBuildProjectDirectory)/../../content</RustyEngineProductContentRoot>
    <RustyEngineProductUiProjectionStream>rusty-hotel</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>rusty.hotel.hud</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineProductInputCursorMode>pointer-lock</RustyEngineProductInputCursorMode>
    <!-- Hotel authors every world light, and its lamps cast the shadows the rooms are read by. Every shadowed lamp
         casts; the budget (in shadow layers, six per lamp) is a safety cap a floor's lamps stay well under. -->
    <RustyEngineProductSceneShadows>enabled</RustyEngineProductSceneShadows>
    <RustyEngineProductShadowBudget>1024</RustyEngineProductShadowBudget>
    <!-- A generated floor lights itself with 80 or more ranged lamps: bin them per screen cluster. -->
    <RustyEngineProductClusteredLighting>enabled</RustyEngineProductClusteredLighting>
    <RustyEngineProductDefaultWorldLights>disabled</RustyEngineProductDefaultWorldLights>
    <RustyEngineWatchPaths>$(MSBuildProjectDirectory);$(RustyEngineProductUiRoot);$(RustyEngineProductContentRoot)</RustyEngineWatchPaths>
  </PropertyGroup>

  <ItemGroup>
    <RustyEngineProductInputIntent Include="hotel.supplies" Value="payload:hotel.supplies.v1" />
    <RustyEngineProductInputIntent Include="hotel.spirit.equip" Value="payload:hotel.spirit.equip.v2" />
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
  </ItemGroup>
</Project>
